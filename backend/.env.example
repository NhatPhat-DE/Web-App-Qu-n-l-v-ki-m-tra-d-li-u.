# Example only: replace locally; do not commit backend/.env.
DATABASE_URL=postgresql+psycopg://demo_user:change_me@127.0.0.1:5432/data_catalog
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=data_catalog
POSTGRES_PORT=5432

# Auth only: provision a stable random secret locally (hex, at least 32 bytes).
# Blank intentionally; current business APIs do not require auth configuration yet.
AUTH_CSRF_SECRET=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false

# AI preview only: separate stable hex secret (32-128 bytes); provision locally.
# Never reuse AUTH_CSRF_SECRET. Missing configuration disables preview only.
AI_PREVIEW_SECRET=
# Provider/model are intentionally not configured in 26C. No API key required.

# Gemini is the only provider. Provision key locally; never commit backend/.env.
GEMINI_API_KEY=
# Explicit model ID, e.g. gemini-3.5-flash-lite; blank disables provider calls.
# No latest alias or automatic model fallback. Confirm budget before opting in.
GEMINI_MODEL=
